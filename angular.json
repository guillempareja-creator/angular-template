{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app-template": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "assets": ["src/assets"],
            "styles": ["src/styles/app.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/fake-backend/enable-mocking.ts",
                  "with": "src/fake-backend/enable-mocking.noop.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "3kB",
                  "maximumError": "6kB"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "250kB",
                  "maximumError": "350kB"
                }
              ],
              "outputHashing": "all"
            },
            "tst": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.tst.ts"
                },
                {
                  "replace": "src/fake-backend/enable-mocking.ts",
                  "with": "src/fake-backend/enable-mocking.noop.ts"
                }
              ],
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "extractLicenses": false,
              "namedChunks": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                "src/assets",
                {
                  "glob": "mockServiceWorker.js",
                  "input": "src/fake-backend/",
                  "output": "/"
                }
              ]
            },
            "testing": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "app-template:build:production"
            },
            "development": {
              "buildTarget": "app-template:build:development"
            },
            "tst": {
              "buildTarget": "app-template:build:tst"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "app-template:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "buildTarget": ":build:testing",
            "tsConfig": "tsconfig.spec.json",
            "coverage": true,
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": [
              "src/app/**/*.spec.ts",
              "src/app/**/*.types.ts",
              "src/app/**/*.enum.ts",
              "src/app/app.config.ts",
              "src/app/app.routes.ts"
            ],
            "coverageReporters": ["text-summary", "html", "lcovonly"],
            "coverageThresholds": {
              "statements": 90,
              "branches": 85,
              "functions": 90,
              "lines": 90,
              "perFile": true
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}

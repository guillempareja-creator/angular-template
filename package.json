{
  "name": "app-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "rename": "node scripts/rename-project.mjs",
    "start": "ng serve",
    "start:tst": "ng serve --configuration=tst",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:file": "ng test --watch=false --coverage=false --include",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings=0",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:unused": "knip",
    "format": "prettier --write . && stylelint \"src/**/*.scss\" --fix",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:static": "npm run format:check && npm run lint && npm run lint:styles && npm run lint:arch && npm run lint:unused && npm run typecheck && node scripts/ai/dod.mjs stamp static",
    "check": "npm run check:static && npm run test:ci && npm run build && npm run e2e && node scripts/ai/dod.mjs stamp full",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-prettier": "^5.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "src/fake-backend"
    ]
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{js,mjs,cjs,json,md,yml}": [
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write",
      "stylelint --fix --max-warnings=0"
    ]
  }
}
